; Engine configuration file.
; POLICE SIMULATOR 3D — Godot 4.7.2 Stable
config_version=5

[application]
config/name="POLICE SIMULATOR 3D"
config/description="شبیه‌ساز سه‌بعدی گشت شهری با تمرکز بر خدمت‌رسانی و حل مسئله"
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameState="*res://scripts/autoload/game_state.gd"
LocaleManager="*res://scripts/autoload/locale_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
toggle_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
toggle_report={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
toggle_siren={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
horn={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":72)]
}
handbrake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[physics]
3d/default_gravity=9.8
3d/physics_engine="GodotPhysics3D"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
